# ---- Required for the full experience ---------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
# Optional: a proxy in front of the Gemini API (e.g. a hackathon key proxy). Leave blank for Google directly.
GEMINI_BASE_URL=
# Per-frame vision timeout (the frame reply, incl. YOLO hazards, waits for it: keep it short)
GEMINI_TIMEOUT_S=10
# Fast model for the per-frame perception/safety loop
GEMINI_MODEL=gemini-3.8-flash
VISION_THINKING_LEVEL=minimal

# Brain: tool-calling model that handles voice turns (agents are its tools).
# AGENT_MODE=rules turns the brain off and uses the deterministic intent parser only.
AGENT_MODE=brain
BRAIN_MODEL=gemini-4-argon
BRAIN_THINKING_LEVEL=low
BRAIN_MAX_STEPS=6
BRAIN_TIMEOUT_S=40

# Optional OpenAI key for Whisper speech-to-text (without it, Gemini transcribes)
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# Google Maps Platform key with these APIs enabled:
#   Routes API, Places API (New), Geocoding API
GOOGLE_MAPS_API_KEY=your-google-maps-key
# Only set true if your Cloud project already has the *legacy* Directions API
# enabled (new projects can't enable it since March 2025).
USE_LEGACY_DIRECTIONS=false

# ---- Local models -------------------------------------------------------------
ENABLE_YOLO=true
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.35
ENABLE_OCR=true
OCR_LANGUAGES=en
OCR_GPU=false

# ---- Behaviour ------------------------------------------------------------------
SPEECH_COOLDOWN_S=10
CRITICAL_COOLDOWN_S=4
ARRIVAL_RADIUS_M=30
STEP_ADVANCE_RADIUS_M=15
OFFROUTE_THRESHOLD_M=20
GROUND_FLOOR_IS_ONE=true

# ---- Infra --------------------------------------------------------------------------
DB_PATH=visionguide.db
CORS_ORIGINS=*
LOG_LEVEL=INFO
